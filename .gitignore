.env
__pycache__/
*.pyc
.venv/
.pytest_cache/

# keep only the runs we deliberately preserve for the demo
runs/*
!runs/.gitkeep
# the frontend's cache ships with the repo so the gallery works on a fresh clone
!runs/index.json
!runs/demo-final/
!runs/demo-final/**

# never preserve bytecode from a run workspace
runs/demo-final/**/__pycache__/
runs/demo-final/**/*.pyc

# generated by make_site.sh for deployment
site/
